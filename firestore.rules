rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regras de Segurança do Kumon Onpoint
    // Professores autenticados via Google têm acesso aos dados da unidade
    match /kumon_teachers/{teacherId} {
      allow read, write: if request.auth != null;
    }

    match /kumon_students/{studentId} {
      allow read, write: if request.auth != null;
    }

    match /kumon_subjects/{subjectId} {
      allow read, write: if request.auth != null;
    }

    match /kumon_attendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }
  }
}
